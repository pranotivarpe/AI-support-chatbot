# ─── Database ────────────────────────────────────────────────────────────────
# Any PostgreSQL 15+ with the pgvector extension (Neon, Supabase, RDS, Docker).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Auth ────────────────────────────────────────────────────────────────────
# Random string, 32+ chars. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Public URL of this app (used in the install snippet and notification emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── AI provider ─────────────────────────────────────────────────────────────
# Chat answers:  gemini | groq | openai | mock   (mock = offline demo, no key)
AI_PROVIDER=gemini
# Embeddings:    gemini | openai | mock          (defaults to match AI_PROVIDER;
#                Groq has no embeddings, so AI_PROVIDER=groq embeds with Gemini)
# EMBEDDING_PROVIDER=gemini

# Google Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-flash-lite-latest      # fast (~1s), great for grounded answers
# GEMINI_FALLBACK_MODEL=gemini-flash-latest        # used when the main model is overloaded
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Groq (free tier, very fast): https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# OpenAI (or any OpenAI-compatible API via OPENAI_BASE_URL)
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-5-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=

# ─── Email notifications (optional) ──────────────────────────────────────────
# Lead + handoff alerts. Without a key, notifications are logged to the console.
# RESEND_API_KEY=
# EMAIL_FROM="SupportPilot <alerts@yourdomain.com>"

# ─── Crawler ─────────────────────────────────────────────────────────────────
# CRAWL_MAX_PAGES=25
